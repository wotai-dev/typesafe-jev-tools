{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/typesafe-check.sh\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "TypeSafe check"
          }
        ]
      }
    ]
  }
}
