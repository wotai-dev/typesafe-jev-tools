# Copy to .env.local (gitignored) and fill in.

# Required. Read from the environment by @typesafe-ai/sdk.
TYPESAFE_API_KEY=

# The versioned model ID, not an alias. Aliases move when a release ships, and
# confidence thresholds are tuned against a specific version.
JEV_MODEL=jev-1.13.0

# Where the pinned docker-compose server is listening.
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=jevbot

# Provisional confidence bands for the live gate, written by the calibration
# pilot (U5). The report recomputes and freezes its own bands from the measured
# run; these only drive the in-run gate. Left empty until the pilot has run --
# a guessed value here would silently become the thing the bot acts on.
JEV_BAND_LOW=
JEV_BAND_HIGH=
